{
	// MINUEND custody vault AA (minuend-v2) — pure asset custody.
	//
	// Trust model: NO owner key. This AA holds the collateral (base) and the
	// PERP governance asset and pays ONLY proof-gated withdrawals against
	// the rollup AA (ROLLUP_AA_HERE) finalized assertion forest. It accepts
	// no assertions, has no lock/challenge/finalize path, and cannot be
	// upgraded — a later custody AA migrates funds through the same
	// finalized-root withdrawal path.
	//
	// WITHDRAWALS ARE PROOF-GATED against the rollup AA's last FINALIZED
	// witness root wit_root_<h> (#47 A2 — Obyte merkle, the same tree the
	// dispute AAs judge unit by unit through trace_root):
	//   adr:{trigger.address}:{account_hex}     binds the payee to an account
	//   acct:{account_hex}:{collateral}:{perp}:{withdrawn}
	// withdraw requires amount, account (64 hex), collateral, perp,
	// withdrawn, adr_proof and acct_proof ({root, siblings, index} as
	// produced by ocore merkle.getMerkleProof / Rust obyte_merkle::proof).
	// withdrawn = the leaf's cumulative withdrawal total W — the
	// sidechain's own debit record and the ONLY payment authority
	// (#37-11): the gate is amount + wd_<addr> <= withdrawn, so payouts are
	// bounded by debited-withdrawn bytes, wd_ advances kill stale-leaf
	// replays, and later roots raise W so sequential withdrawals never
	// dead-end; amount non-negative; decimal strings capped at 15 chars;
	// optional perp_amount claims less than the full PERP remainder.
	// Before #47 the vault paid from the 1024-hex aa_forest, whose leaves
	// are never published — a forged forest leaf could not be pointed at by
	// any dispute predicate (A2). The witness root is challengeable: W and
	// the adr: binding are pinned per unit by minuend_dispute_bind.aa.
	// The engine binds one address to at most one account, so a payee has
	// exactly one adr: leaf. ROLLUP_AA_HERE is substituted at deploy/test
	// time.
	// State vars: wd_<addr> (cumulative base withdrawn), wp_<addr>
	// (cumulative PERP withdrawn), pperp_<addr> (PERP deposits received).
	bounce_fees: { base: 10000 },
	messages: {
		cases: [
			{
				if: "{trigger.data.deposit}",
				init: "{
					if (trigger.output[[asset=base]] - 10000 <= 0)
						bounce('deposit too small');
				}",
				messages: [
					{
						app: "state",
						state: "{
						}"
					}
				]
			},
			{
				// PERP governance asset deposit: credits pperp_<address>,
				// the reconciliation mirror of the sidechain's GovDeposit
				// credits (keyed by aa_unit). Without this explicit case
				// ocore's auto-bounce would swallow the asset-bearing
				// payment; here it is accepted and ledgered instead.
				if: "{trigger.data.deposit_perp}",
				init: "{
					if (!(trigger.output[[asset='PERP_ASSET_ID_HERE']] > 0))
						bounce('bad deposit');
				}",
				messages: [
					{
						app: "state",
						state: "{
							var['pperp_' || trigger.address] = (var['pperp_' || trigger.address] otherwise 0) + trigger.output[[asset='PERP_ASSET_ID_HERE']];
						}"
					}
				]
			},
			{
				// PROOF-GATED withdrawal against the rollup AA's finalized
				// witness root (#47 A2). Balance authority = the proven W.
				if: "{trigger.data.withdraw}",
				init: "{
					$lf = var['ROLLUP_AA_HERE']['last_finalized'];
					if (!$lf)
						bounce('not finalizable');
					// Presence gate: missing trigger fields evaluate to boolean
					// false, so typeof()==='boolean' detects absence while legal
					// falsy values ('0', 0) pass.
					if (typeof(trigger.data.amount) == 'boolean'
						OR typeof(trigger.data.amount) == 'string'
						OR typeof(trigger.data.withdrawn) == 'boolean'
						OR typeof(trigger.data.account) == 'boolean'
						OR typeof(trigger.data.collateral) == 'boolean'
						OR typeof(trigger.data.perp) == 'boolean'
						OR !trigger.data.adr_proof
						OR !trigger.data.acct_proof)
						bounce('bad claim');
					if (length(trigger.data.account) != 64)
						bounce('bad claim');
					// Root source: the finalized height's witness root.
					$wr = var['ROLLUP_AA_HERE']['wit_root_' || $lf];
					if (!$wr)
						bounce('no root');
					// perp length cap must run BEFORE the subtraction below: a
					// malformed over-15-digit string would fatal in the
					// arithmetic instead of bouncing.
					if (length(trigger.data.perp) > 15)
						bounce('bad claim amount');
					// Single gate for leaf ownership and the GLOBAL cumulative
					// caps wd_/wp_ (anti-replay across heights; every withdrawal
					// caps the claim; perp_amount optionally claims less).
					$unclaimed = trigger.data.perp - (var['wp_' || trigger.address] otherwise 0);
					$perp_claimed = (typeof(trigger.data.perp_amount) == 'number'
						AND trigger.data.perp_amount >= 0
						AND trigger.data.perp_amount < $unclaimed)
						? trigger.data.perp_amount : $unclaimed;
					// #12: PERP redemption is disabled until claim->burn exists
					// on the sidechain (only GovWithdraw reduces
					// perp_balances): paying PERP here while the mirrored
					// balance keeps its vote weight would double-count
					// governance. Collateral withdrawals use `perp_amount: 0`.
					if ($perp_claimed > 0)
						bounce('perp claim needs burn');
					// Length caps come FIRST (OR short-circuits): a malformed
					// over-15-digit string must bounce before the arithmetic.
					// #37-11: W (cumulative debited withdrawals) is the ONLY
					// spendable-by-vault quantity; collateral is live trading
					// balance and never gates a payment.
					if (length(trigger.data.collateral) > 15 OR length(trigger.data.withdrawn) > 15
						OR trigger.data.amount < 0
						OR trigger.data.amount + (var['wd_' || trigger.address] otherwise 0) > trigger.data.withdrawn
						OR $perp_claimed < 0)
						bounce('bad claim amount');
					// #47 A2: payee binding + balance leaf, both proven against
					// the finalized witness root.
					$adr_leaf = 'adr:' || trigger.address || ':' || trigger.data.account;
					$acct_leaf = 'acct:' || trigger.data.account || ':' || trigger.data.collateral || ':' || trigger.data.perp || ':' || trigger.data.withdrawn;
					if (trigger.data.adr_proof.root != $wr OR !is_valid_merkle_proof($adr_leaf, trigger.data.adr_proof))
						bounce('bad binding proof');
					if (trigger.data.acct_proof.root != $wr OR !is_valid_merkle_proof($acct_leaf, trigger.data.acct_proof))
						bounce('bad merkle root');
				}",
				messages: [
					{
						// Pure-PERP withdrawal (amount=0) emits no base output —
						// Oscript forbids 0-amount outputs.
						if: "{trigger.data.amount > 0}",
						app: "payment",
						payload: {
							asset: "base",
							outputs: [
								{
									address: "{trigger.address}",
									amount: "{trigger.data.amount}"
								}
							]
						}
					},
					{
						// Oscript forbids 0-amount outputs — emit the PERP
						// payment only when something is actually claimed.
						if: "{$perp_claimed > 0}",
						app: "payment",
						payload: {
							asset: "PERP_ASSET_ID_HERE",
							outputs: [
								{
									address: "{trigger.address}",
									amount: "{$perp_claimed}"
								}
							]
						}
					},
					{
						app: "state",
						state: "{
							var['wd_' || trigger.address] += trigger.data.amount;
							var['wp_' || trigger.address] += $perp_claimed;
						}"
					}
				]
			}
		]
	}
}
