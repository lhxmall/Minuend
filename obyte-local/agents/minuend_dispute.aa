{
	// MINUEND dispute AA (minuend-v2) — one-shot fraud predicates.
	//
	// The ONLY party allowed to fail a rollup height. Each predicate
	// verifies an Oscript-checkable claim against the commitments the
	// rollup AA stores for height h and, when fraud is proven, forwards
	// {verdict:'fraud', height, challenger} with 10000 bytes to the rollup
	// AA. Failed predicates bounce ('no fraud') and coins return; no
	// challenge bond exists (pay-to-kill is impossible: every bounce path
	// here refuses to freeze anything).
	//
	// Bind: {bind:1, rollup:<addr>} payment 20000 -> forwards 10000 to the
	// rollup with {set_dispute:1}. The fill-math dispute AA binds with
	// {bind_fill:1, rollup:<addr>} -> {set_dispute_fill:1}. Round 2: P-ghost
	// and P-skip moved to minuend_dispute_book.aa (ops budget).
	// Challenge: {height, pred, rollup:<addr>, k, ...proofs} payment 20000.
	// The rollup address rides every trigger instead of living in this
	// definition: the rollup hardcodes THIS address (#13 anti-hijack), and
	// mutual hardcoding would be a chash cycle (each address is the hash
	// of its own definition).
	// Witness leaves (crates/minuend-state/src/lib.rs wit_leaves):
	//   acct:{acct_hex_64}:{collateral}:{perp}:{W}
	//   pos:{acct_hex_64}:{market}:{qty_signed}:{entry}:{isolated:0|1}:{bucket}
	//   ord:{order_hex}:{market}:{side}:{price}:{seq}:{remaining}:{acct_hex}:{isolated:0|1}:{margin_left}
	// Op descriptors (crates/minuend-settle/src/lib.rs ops_element):
	//   d:{acct}:{amount}:{addr}:{aa_unit_b64}   D:{acct}:{amount}:{addr}
	//   w:{acct}:{amount}:{nonce}   W:{acct}:{amount}:{nonce}
	//   c:{acct}:{order_hex}   p:{acct}:{market}:{side}:{price}:{qty}:{isolated}:{margin}:{tif}:{typ}
	// Fill descriptors (fills_element): f:{unit}:{idx}:{taker}:{maker}:
	//   {taker_order}:{maker_order}:{market}:{price}:{qty}:{seq}:{side}:
	//   {kind}:{taker_post}
	// kind 0=book 1=funding-cash 2=ADL-no-fee 3=liquidation(+keeper)
	// Empty-sentinel wit root (obyte_merkle::root(["empty"]), pinned by the
	// Rust unit test): Lhz6grA1wmy7va5jLOoHBRTri3c/YWqur2aOLwvo8Q0=
	bounce_fees: { base: 10000 },
	messages: {
		cases: [
			{
				if: "{trigger.data.bind}",
				init: "{
					if (trigger.output[[asset=base]] < 20000) bounce('need fee');
					// Rollup address arrives per-bind (the rollup hardcodes
					// THIS address instead — mutual hardcoding would be a
					// chash cycle); validate it before forwarding.
					if (typeof(trigger.data.rollup) == 'boolean' OR length(trigger.data.rollup) != 32 OR !is_valid_address(trigger.data.rollup))
						bounce('bad rollup');
				}",
				messages: [
					{
						app: "payment",
						payload: {
							asset: "base",
							outputs: [
								{
									address: "{trigger.data.rollup}",
									amount: 10000
								}
							]
						}
					},
					{
						app: "data",
						payload: {
							set_dispute: 1
						}
					},
					{
						app: "state",
						state: "{
							var['bound'] = 1;
						}"
					}
				]
			},
			{
				// P-deposit / P-withdraw (and PERP gov variants D:/W:): the
				// proven post collateral/perp leg disagrees with op math.
				if: "{trigger.data.pred == 'deposit' OR trigger.data.pred == 'withdraw'}",
				init: "{
					$h = trigger.data.height;
					// The rollup address rides every challenge: this AA's
					// address is hardcoded INTO the rollup (#13), so this
					// definition must not hardcode the rollup back — mutual
					// hardcoding is a chash cycle. State checks and the
					// verdict payment use the same value, so a bogus address
					// can only bounce here or deliver the verdict to itself.
					if (typeof(trigger.data.rollup) == 'boolean' OR length(trigger.data.rollup) != 32 OR !is_valid_address(trigger.data.rollup))
						bounce('bad rollup');
					$rollup = trigger.data.rollup;
					$n = var[$rollup]['unit_count_' || $h];
					if (!$h OR !$n) bounce('no height');
					if (var[$rollup]['frozen_' || $h] OR timestamp >= (var[$rollup]['submitted_at_' || $h] otherwise 0) + 3600)
						bounce('challenge not possible');
					if (trigger.data.trace_root != var[$rollup]['trace_root_' || $h]
						OR trigger.data.ops_root != var[$rollup]['ops_root_' || $h]
						OR trigger.data.units_root != var[$rollup]['units_root_' || $h]
						OR trigger.data.units_set_root != var[$rollup]['units_set_root_' || $h]
						OR trigger.data.fills_root != var[$rollup]['fills_root_' || $h])
						bounce('stale roots');
					$k = trigger.data.k;
					if (!is_integer($k) OR $k < 0 OR $k >= $n)
						bounce('bad k');
					$op = trigger.data.op;
					if (!trigger.data.ops_proof OR trigger.data.ops_proof.index != $k OR trigger.data.ops_proof.root != trigger.data.ops_root
						OR !is_valid_merkle_proof($op, trigger.data.ops_proof))
						bounce('bad ops proof');
					$deposit = trigger.data.pred == 'deposit';
					$lo = $deposit ? 'd:' : 'w:';
					$up = $deposit ? 'D:' : 'W:';
					if (!starts_with($op, $lo) AND !starts_with($op, $up)) bounce('no fraud');
					// #37-5: gov ops (D:/W:) move PERP balances, never
					// collateral (exec gov_deposit/gov_withdraw only touch
					// perp_balances/supply). A single arm judging them by
					// collateral math verdicts honest gov batches — compare
					// the PERP column instead, and pin collateral unchanged.
					$gov = starts_with($op, 'D:') OR starts_with($op, 'W:');
					// Pre-wit anchor: k==0 -> previous height's committed root
					// (height 1 -> empty sentinel); k>0 -> trace membership at
					// k-1 proves the pre state.
					$pre_wit = trigger.data.pre_wit;
					if ($k == 0){
						if ($h == 1){
							if ($pre_wit != 'Lhz6grA1wmy7va5jLOoHBRTri3c/YWqur2aOLwvo8Q0=') bounce('bad pre wit');
						} else {
							if ($pre_wit != var[$rollup]['wit_root_' || ($h - 1)]) bounce('bad pre wit');
						}
					} else {
						if (!trigger.data.pre_proof OR trigger.data.pre_proof.index != $k - 1 OR trigger.data.pre_proof.root != trigger.data.trace_root
							OR !is_valid_merkle_proof($pre_wit, trigger.data.pre_proof))
							bounce('bad pre proof');
					}
					$pre_leaf = trigger.data.pre_leaf;
					$post_leaf = trigger.data.post_leaf;
					$post_wit = trigger.data.post_wit;
					// Post binding: post_wit must be the k-th element of the
					// COMMITTED trace, so the leaf proof below proves against
					// an operator-committed root instead of an attacker tree.
					if (!trigger.data.post_proof OR trigger.data.post_proof.index != $k OR trigger.data.post_proof.root != trigger.data.trace_root
						OR !is_valid_merkle_proof($post_wit, trigger.data.post_proof))
						bounce('bad post proof');
					$acct = substring($op, 2, 64);
					// op = 'd:' || 64-hex || ':' || amount[:nonce]; the colon
					// after the hex sits at index 66, so start the tail there.
					// substring(s, start, length): length caps at the rest.
					$tail = substring($op, 66, length($op));
					// tail = ':' || amount[:nonce]. ocore's index_of has no
					// start arg, so drop the leading colon first, then cut at
					// the next colon (withdraw/gov) or take the remainder.
					$amt = substring($tail, 1, length($tail));
					$next = index_of($amt, ':');
					$amount = substring($amt, 0, $next < 0 ? length($amt) : $next);
					// A descriptor whose amount is not a decimal integer is
					// never engine output (ops_element prints the integer):
					// such an op cannot be judged by the math below, so a
					// proven post leaf under it is fraud by itself.
					$badop = length($amount) > 39 OR contains($amount, 'e') OR contains($amount, 'E')
						OR !is_integer(json_parse($amount));
					$tail1 = substring($post_leaf, 70, length($post_leaf));
					$col1 = substring($tail1, 0, index_of($tail1, ':'));
					// #37-5: acct leaf columns are acct:hex:col:perp:W —
					// the PERP leg sits one colon past collateral.
					$ptail1 = substring($tail1, length($col1) + 1, length($tail1));
					$perp1 = substring($ptail1, 0, index_of($ptail1, ':'));
					if (typeof($post_leaf) == 'boolean' OR typeof($post_wit) == 'boolean'
						OR !is_valid_merkle_proof($post_leaf, trigger.data.post_leaf_proof)
						OR trigger.data.post_leaf_proof.root != $post_wit)
						bounce('bad leaf proof');
					if (substring($post_leaf, 5, 64) != $acct) bounce('bad leaf');
					if (substring($post_leaf, 0, 5) != 'acct:') bounce('bad leaf');
					if (!$badop) {
					// Pre leg: either the acct leaf proves member (old
					// account), or pre_absent non-membership proves a fresh
					// account (pre col = 0). Each branch sets $match (the op
					// math / rejected-unchanged outcome holds) and $cred (a
					// non-gov deposit was CREDITED: R2-A-3 backing applies).
					if (trigger.data.pre_absent){
						// R2-A-4: the prefix range is [acct:X:, acct:X;) — ';'
						// sorts after ':' so the account's real leaf is INSIDE
						// it. (The old `$ghost < right` let the honest
						// (previous, own) neighbour pair "prove" an existing
						// account absent.) R2-A-5: integer index >= 0 and
						// ':'-bearing neighbours. No after-max arm: every tree
						// ends with the `~:end` sentinel (R2-A-10).
						$ghost = 'acct:' || $acct || ':';
						$ghi = 'acct:' || $acct || ';';
						$hit1 = trigger.data.left AND trigger.data.right
							AND contains(trigger.data.left, ':') AND contains(trigger.data.right, ':')
							AND is_integer(trigger.data.left_proof.index) AND trigger.data.left_proof.index >= 0
							AND trigger.data.left_proof.index + 1 == trigger.data.right_proof.index
							AND trigger.data.left_proof.root == $pre_wit
							AND trigger.data.right_proof.root == $pre_wit
							AND trigger.data.left < $ghost AND $ghi <= trigger.data.right
							AND is_valid_merkle_proof(trigger.data.left, trigger.data.left_proof)
							AND is_valid_merkle_proof(trigger.data.right, trigger.data.right_proof);
						$hit2 = trigger.data.left AND contains(trigger.data.left, ':')
							AND trigger.data.left_proof.index == 0
							AND trigger.data.left_proof.root == $pre_wit
							AND $ghi <= trigger.data.left
							AND is_valid_merkle_proof(trigger.data.left, trigger.data.left_proof);
						if (!$hit1 AND !$hit2) bounce('no fraud');
						// #47 B6: gov ops never create an account, so a proven
						// post leaf on a pre-absent account is fraud for D:/W:.
						// A rejected op leaves no leaf (or an empty one, col 0).
						$match = !$gov AND ($col1 == '0' OR ($deposit ? (0 + $amount == $col1) : (0 - $amount == $col1)));
						$cred = !$gov AND $deposit AND $col1 != '0' AND 0 + $amount == $col1;
					} else {
						if (typeof($pre_leaf) == 'boolean'
							OR !is_valid_merkle_proof($pre_leaf, trigger.data.pre_leaf_proof)
							OR trigger.data.pre_leaf_proof.root != $pre_wit)
							bounce('bad leaf proof');
						if (substring($pre_leaf, 0, 5) != 'acct:' OR substring($pre_leaf, 5, 64) != $acct) bounce('bad leaf');
						$tail0 = substring($pre_leaf, 70, length($pre_leaf));
						$col0 = substring($tail0, 0, index_of($tail0, ':'));
						$ptail0 = substring($tail0, length($col0) + 1, length($tail0));
						$perp0 = substring($ptail0, 0, index_of($ptail0, ':'));
						// Gov old account: PERP moves by amount, collateral pinned.
						// #47 (cross-PR): or the op was REJECTED and the moving
						// column is unchanged — an honest outcome.
						$match = $gov ? (($perp0 == $perp1 OR ($deposit ? ($perp0 + $amount == $perp1) : ($perp0 - $amount == $perp1))) AND $col0 == $col1) : ($col0 == $col1 OR ($deposit ? ($col0 + $amount == $col1) : ($col0 - $amount == $col1)));
						$cred = !$gov AND $deposit AND $col0 != $col1 AND $col0 + $amount == $col1;
					}
					// R2-A-3: a credited collateral deposit must be BACKED by
					// the rollup's genuine vault (parameterized instance of the
					// hardcoded base, derived — never caller-supplied):
					//   dep_<aa_unit> = '{payer}:{amount}' recorded, payer == the
					//   op's address and op amount <= the recorded amount;
					//   the anchor's `dep:{aa_unit}` marker NOT already in the pre
					//   tree (re-credit) — proven member => fraud;
					//   the marker present in the post tree — proven absent
					//   (adjacent straddle / before-min) => fraud.
					if ($cred) {
						$O = split($op, ':');
						$vault = chash160(['autonomous agent', {base_aa: 'VAULT_BASE_HERE', params: {rollup: $rollup}}]);
						$rec = (array_length($O) == 5) ? (var[$vault]['dep_' || $O[4]] otherwise '') : '';
						$backed = length($O[3]) == 32 AND starts_with($rec, $O[3] || ':')
							AND length($rec) <= 48
							AND 0 + $amount <= substring($rec, 33) + 0;
						$mk = 'dep:' || ((array_length($O) == 5) ? $O[4] : '');
						$dup = trigger.data.dep_pre_proof AND trigger.data.dep_pre_proof.root == $pre_wit
							AND is_valid_merkle_proof($mk, trigger.data.dep_pre_proof);
						$nomark = trigger.data.dleft AND contains(trigger.data.dleft, ':')
							AND trigger.data.dleft_proof.root == $post_wit
							AND ((trigger.data.dright AND contains(trigger.data.dright, ':')
								AND is_integer(trigger.data.dleft_proof.index) AND trigger.data.dleft_proof.index >= 0
								AND trigger.data.dleft_proof.index + 1 == trigger.data.dright_proof.index
								AND trigger.data.dright_proof.root == $post_wit
								AND trigger.data.dleft < $mk AND $mk < trigger.data.dright
								AND is_valid_merkle_proof(trigger.data.dright, trigger.data.dright_proof))
							OR (trigger.data.dleft_proof.index == 0 AND $mk < trigger.data.dleft))
							AND is_valid_merkle_proof(trigger.data.dleft, trigger.data.dleft_proof);
						if ($backed AND !$dup AND !$nomark) bounce('no fraud');
					} else {
						if ($match) bounce('no fraud');
					}
					}
					if (trigger.output[[asset=base]] < 20000) bounce('need fee');
				}",
				messages: [
					{
						app: "payment",
						payload: {
							asset: "base",
							outputs: [
								{
									address: "{trigger.data.rollup}",
									amount: 10000
								}
							]
						}
					},
					{
						app: "data",
						payload: {
							verdict: "fraud",
							height: "{trigger.data.height}",
							challenger: "{trigger.address}"
						}
					},
					{
						app: "state",
						state: "{
							var['fraud_' || trigger.data.height] = trigger.address;
						}"
					}
				]
			},
			{
				// P-escrow (cancel only): the proven post collateral moved by
				// exactly the canceled order's escrow refund — post == pre +
				// margin_left, exact, no range. `p:` has NO arm: a Place unit
				// matches inside the same unit (fee/PnL move collateral by an
				// amount Oscript cannot predict), so any p: range would false-
				// fire honest fills; place-escrow lies stay uncovered (#6 half).
				if: "{trigger.data.pred == 'escrow'}",
				init: "{
					$h = trigger.data.height;
					// The rollup address rides every challenge: this AA's
					// address is hardcoded INTO the rollup (#13), so this
					// definition must not hardcode the rollup back — mutual
					// hardcoding is a chash cycle. State checks and the
					// verdict payment use the same value, so a bogus address
					// can only bounce here or deliver the verdict to itself.
					if (typeof(trigger.data.rollup) == 'boolean' OR length(trigger.data.rollup) != 32 OR !is_valid_address(trigger.data.rollup))
						bounce('bad rollup');
					$rollup = trigger.data.rollup;
					$n = var[$rollup]['unit_count_' || $h];
					if (!$h OR !$n) bounce('no height');
					if (var[$rollup]['frozen_' || $h] OR timestamp >= (var[$rollup]['submitted_at_' || $h] otherwise 0) + 3600)
						bounce('challenge not possible');
					if (trigger.data.trace_root != var[$rollup]['trace_root_' || $h]
						OR trigger.data.ops_root != var[$rollup]['ops_root_' || $h]
						OR trigger.data.units_root != var[$rollup]['units_root_' || $h]
						OR trigger.data.units_set_root != var[$rollup]['units_set_root_' || $h]
						OR trigger.data.fills_root != var[$rollup]['fills_root_' || $h])
						bounce('stale roots');
					$k = trigger.data.k;
					if (!is_integer($k) OR $k < 0 OR $k >= $n)
						bounce('bad k');
					$op = trigger.data.op;
					if (!starts_with($op, 'c:')) bounce('no fraud');
					if (!trigger.data.ops_proof OR trigger.data.ops_proof.index != $k OR trigger.data.ops_proof.root != trigger.data.ops_root
						OR !is_valid_merkle_proof($op, trigger.data.ops_proof))
						bounce('bad ops proof');
					$pre_wit = trigger.data.pre_wit;
					if ($k == 0){
						if ($h == 1){
							if ($pre_wit != 'Lhz6grA1wmy7va5jLOoHBRTri3c/YWqur2aOLwvo8Q0=') bounce('bad pre wit');
						} else {
							if ($pre_wit != var[$rollup]['wit_root_' || ($h - 1)]) bounce('bad pre wit');
						}
					} else {
						if (!trigger.data.pre_proof OR trigger.data.pre_proof.index != $k - 1 OR trigger.data.pre_proof.root != trigger.data.trace_root
							OR !is_valid_merkle_proof($pre_wit, trigger.data.pre_proof))
							bounce('bad pre proof');
					}
					$post_wit = trigger.data.post_wit;
					if (!trigger.data.post_proof OR trigger.data.post_proof.index != $k OR trigger.data.post_proof.root != trigger.data.trace_root
						OR !is_valid_merkle_proof($post_wit, trigger.data.post_proof))
						bounce('bad post proof');
					$acct = substring($op, 2, 64);
					// op = 'c:' || 64-hex acct || ':' || 64-hex order id;
					// the second colon sits at index 66, order hex at 67.
					$order_hex = substring($op, 67, 64);
					if (length($order_hex) != 64) bounce('bad op');
					$pre_leaf = trigger.data.pre_leaf;
					$post_leaf = trigger.data.post_leaf;
					if (typeof($pre_leaf) == 'boolean'
						OR !is_valid_merkle_proof($pre_leaf, trigger.data.pre_leaf_proof)
						OR trigger.data.pre_leaf_proof.root != $pre_wit)
						bounce('bad leaf proof');
					if (substring($pre_leaf, 5, 64) != $acct) bounce('bad leaf');
					if (typeof($post_leaf) == 'boolean'
						OR !is_valid_merkle_proof($post_leaf, trigger.data.post_leaf_proof)
						OR trigger.data.post_leaf_proof.root != $post_wit)
						bounce('bad leaf proof');
					if (substring($post_leaf, 5, 64) != $acct) bounce('bad leaf');
					$tail0 = substring($pre_leaf, 70, length($pre_leaf));
					$col0 = substring($tail0, 0, index_of($tail0, ':'));
					$tail1 = substring($post_leaf, 70, length($post_leaf));
					$col1 = substring($tail1, 0, index_of($tail1, ':'));
					// The canceled order's escrow remainder, from its PRE ord
					// leaf: order id must match the op, owner the op account.
					$pre_ord = trigger.data.pre_ord;
					if (typeof($pre_ord) == 'boolean'
						OR !starts_with($pre_ord, 'ord:' || $order_hex || ':')
						OR !is_valid_merkle_proof($pre_ord, trigger.data.pre_ord_proof)
						OR trigger.data.pre_ord_proof.root != $pre_wit)
						bounce('bad ord proof');
					$O = split($pre_ord, ':');
					if (array_length($O) != 10 OR $O[7] != $acct) bounce('bad ord');
					$margin_left = $O[9] + 0;
					if ($col0 + $margin_left == $col1) bounce('no fraud');
					if (trigger.output[[asset=base]] < 20000) bounce('need fee');
				}",
				messages: [
					{
						app: "payment",
						payload: {
							asset: "base",
							outputs: [
								{
									address: "{trigger.data.rollup}",
									amount: 10000
								}
							]
						}
					},
					{
						app: "data",
						payload: {
							verdict: "fraud",
							height: "{trigger.data.height}",
							challenger: "{trigger.address}"
						}
					},
					{
						app: "state",
						state: "{
							var['fraud_' || trigger.data.height] = trigger.address;
						}"
					}
				]
			},
			{
				// P-omit: a forced unit id (pinned by the rollup inbox before
				// this height's inbox_upto) is missing from units_set_root.
				// Non-membership in the sorted units set is proven by adjacent
				// members, or by lying outside the min/max member.
				if: "{trigger.data.pred == 'omit'}",
				init: "{
					$h = trigger.data.height;
					// The rollup address rides every challenge: this AA's
					// address is hardcoded INTO the rollup (#13), so this
					// definition must not hardcode the rollup back — mutual
					// hardcoding is a chash cycle. State checks and the
					// verdict payment use the same value, so a bogus address
					// can only bounce here or deliver the verdict to itself.
					if (typeof(trigger.data.rollup) == 'boolean' OR length(trigger.data.rollup) != 32 OR !is_valid_address(trigger.data.rollup))
						bounce('bad rollup');
					$rollup = trigger.data.rollup;
					$n = var[$rollup]['unit_count_' || $h];
					if (!$h OR !$n) bounce('no height');
					if (var[$rollup]['frozen_' || $h] OR timestamp >= (var[$rollup]['submitted_at_' || $h] otherwise 0) + 3600)
						bounce('challenge not possible');
					if (trigger.data.trace_root != var[$rollup]['trace_root_' || $h]
						OR trigger.data.ops_root != var[$rollup]['ops_root_' || $h]
						OR trigger.data.units_root != var[$rollup]['units_root_' || $h]
						OR trigger.data.units_set_root != var[$rollup]['units_set_root_' || $h]
						OR trigger.data.fills_root != var[$rollup]['fills_root_' || $h])
						bounce('stale roots');
					$id = trigger.data.unit_id;
					if (typeof($id) == 'boolean' OR length($id) != 64) bounce('bad unit_id');
					$ts = var[$rollup]['inbox_' || $id];
					if (!$ts OR $ts >= var[$rollup]['inbox_upto_' || $h]) bounce('no fraud');
					// #23: {force} pins only a timestamp — the id may name a
					// unit that never existed, and an honest batch correctly
					// omits it. Omit cannot pay out: everything below this
					// unconditional bounce was DELETED (unreachable code
					// costing ~150 ops against the 2000 budget; observable
					// behavior — always 'no fraud', never a verdict — is
					// unchanged).
					bounce('no fraud');
				}",
				messages: [
					{
						app: "payment",
						payload: {
							asset: "base",
							outputs: [
								{
									address: "{trigger.data.rollup}",
									amount: 10000
								}
							]
						}
					},
					{
						app: "data",
						payload: {
							verdict: "fraud",
							height: "{trigger.data.height}",
							challenger: "{trigger.address}"
						}
					},
					{
						app: "state",
						state: "{
							var['fraud_' || trigger.data.height] = trigger.address;
						}"
					}
				]
			}

		]
	}
}
