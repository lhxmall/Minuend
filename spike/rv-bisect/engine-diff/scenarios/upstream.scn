== acct_isolated_bucket_release_rounding    # bucket 100 USD over 0.003: releases 33.333333.. (floor)
dep A 1000
dep B 1000000
ask B 100 0.003
bid A 100 0.003 iso=100
bid B 70 0.001
ask A 70 0.001 iso=0
bid B 60 0.001
ask A 60 0.001 iso=0
bid B 60 0.001
ask A 60 0.001 iso=0

== acct_isolated_release_rounding_odd       # 7 USD over 0.007 BTC, closes of 0.003 / 0.004
dep A 1000
dep B 1000000
ask B 100000 0.007
bid A 100000 0.007 isou=77777777
bid B 99999 0.003
ask A 99999 0.003 iso=0
bid B 99998 0.004
ask A 99998 0.004 iso=0

