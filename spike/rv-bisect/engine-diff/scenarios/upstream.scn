# ---------------------------------------------------------------- boundary scenarios (surviving mutants)
# Isolated cross-pool gate `equity - margin < im + resting`: margin == equity exactly.
== bnd_isolated_margin_equals_equity
dep A 1000
bid A 100000 0.001 iso=1000
dep B 1000
bid B 100000 0.001 iso=999
dep C 2000
bid C 90000 0.001
ask C 110000 0.001 iso=1990

# Taker-fee guard's equity clause `pre_eq >= 0 && pre_eq < fee` with cash >= fee: an isolated close
# whose blow-through leaves cross cash 10 020 USD but cross equity 20 USD (market-2 long 10k under
# the mark) against a 40 USD fee -> Risk. Brackets: pre_eq 0 (reject) and 40 (accept).
== bnd_fee_guard_equity_clause m2
dep T 30125
dep R 1000000
dep S 1000000
ask R 100000 1
bid T 100000 1 iso=10000
ask S 110000 1 m=2
bid T 110000 1 m=2
bid R 80000 1
ask T 80000 1 iso=0

== bnd_fee_guard_equity_zero m2
dep T 30105
dep R 1000000
dep S 1000000
ask R 100000 1
bid T 100000 1 iso=10000
ask S 110000 1 m=2
bid T 110000 1 m=2
bid R 80000 1
ask T 80000 1 iso=0

== bnd_fee_guard_equity_at_fee m2
dep T 30145
dep R 1000000
dep S 1000000
ask R 100000 1
bid T 100000 1 iso=10000
ask S 110000 1 m=2
bid T 110000 1 m=2
bid R 80000 1
ask T 80000 1 iso=0

# Claw when BOTH parties end the fill with negative collateral (counterparty negative).
== bnd_claw_both_negative
dep A 20000
dep B 1000000
dep C 13000
ask B 100000 1
bid A 100000 1
ask C 100000 0.1
bid B 100000 0.1
ask C 100000 0.01
bid C 10000 0.1
ask A 10000 0.1
